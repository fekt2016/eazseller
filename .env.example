# eazseller Environment Variables
# Copy to .env and fill in values
# Never commit .env to git

# API Configuration
VITE_API_BASE_URL=https://api.saiisai.com/api/v1
# Override for staging:
# VITE_API_BASE_URL=https://staging-api.saiisai.com/api/v1

# Local dev: axios already forces http://localhost:4000 when the UI is on localhost.
# Chat/Socket.io now match that automatically (ignores production VITE_API_BASE_URL on localhost).
# Override only if you need a non-default socket host (must be the API, not Vite):
# VITE_SOCKET_URL=http://localhost:4000
# Do NOT use 5173 / 5174 / 5175 here — those are Vite, not Socket.io.

# Cloudinary (public — safe to expose)
VITE_CLOUDINARY_CLOUD_NAME=eazworld
